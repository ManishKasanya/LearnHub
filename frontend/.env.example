# LearnHub Frontend Environment Configuration
#
# Production Deployment (Vercel, Netlify, Render, Railway, AWS):
# Set this environment variable in your hosting platform dashboard
# to the public URL of your deployed Spring Boot backend.
#
# Example:
# VITE_API_URL=https://your-learnhub-backend.onrender.com
#
# For local development:
# Leave blank to use the Vite local proxy (routes /api -> http://localhost:8080)
VITE_API_URL=
