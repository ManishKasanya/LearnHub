{
	"info": {
		"_postman_id": "8f3b25e0-learnhub-4b62-9721-a3f4428472b4",
		"name": "LearnHub Online Learning Platform - REST API Collection",
		"description": "Complete collection of RESTful APIs for LearnHub Final-Year CS Project. Supports Student, Instructor, and Admin operations with JWT authentication.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/health",
							"host": ["{{baseUrl}}"],
							"path": ["api", "health"]
						}
					}
				},
				{
					"name": "Login - Student",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.environment.set('studentToken', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"alice.student@learnhub.com\",\n    \"password\": \"Student@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Login - Instructor",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.environment.set('instructorToken', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"john.instructor@learnhub.com\",\n    \"password\": \"Instructor@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Login - Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.environment.set('adminToken', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@learnhub.com\",\n    \"password\": \"Admin@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Get Current User Profile",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{studentToken}}"}],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "me"]
						}
					}
				},
				{
					"name": "Update Profile",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{studentToken}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fullName\": \"Alice Sharma\",\n    \"headline\": \"CS Senior & Software Engineer\",\n    \"bio\": \"Passionate about full-stack engineering and cloud microservices.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/profile",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "profile"]
						}
					}
				}
			]
		},
		{
			"name": "2. Courses & Catalog",
			"item": [
				{
					"name": "Get All Published Courses (Paginated)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/courses?page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "courses"],
							"query": [
								{"key": "page", "value": "0"},
								{"key": "size", "value": "10"}
							]
						}
					}
				},
				{
					"name": "Search Courses by Keyword",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/courses?search=React&page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "courses"],
							"query": [
								{"key": "search", "value": "React"},
								{"key": "page", "value": "0"},
								{"key": "size", "value": "10"}
							]
						}
					}
				},
				{
					"name": "Get Course Details with Curriculum",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/courses/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "courses", "1"]
						}
					}
				}
			]
		},
		{
			"name": "3. Enrollments & Learning",
			"item": [
				{
					"name": "Enroll in Course",
					"request": {
						"method": "POST",
						"header": [{"key": "Authorization", "value": "Bearer {{studentToken}}"}],
						"url": {
							"raw": "{{baseUrl}}/api/enrollments/courses/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "enrollments", "courses", "1"]
						}
					}
				},
				{
					"name": "Get My Enrolled Courses",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{studentToken}}"}],
						"url": {
							"raw": "{{baseUrl}}/api/enrollments/my-courses?page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "enrollments", "my-courses"],
							"query": [
								{"key": "page", "value": "0"},
								{"key": "size", "value": "10"}
							]
						}
					}
				},
				{
					"name": "Update Lesson Progress",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{studentToken}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"completed\": true,\n    \"watchPosition\": 900\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/lessons/1/progress",
							"host": ["{{baseUrl}}"],
							"path": ["api", "lessons", "1", "progress"]
						}
					}
				}
			]
		},
		{
			"name": "4. Assessment & Quizzes",
			"item": [
				{
					"name": "Get Quiz Questions",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{studentToken}}"}],
						"url": {
							"raw": "{{baseUrl}}/api/quizzes/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "quizzes", "1"]
						}
